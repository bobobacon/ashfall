# ASHFALL server environment — copy to .env for local dev. NEVER commit real values.

# Port the server binds (Render injects this automatically in prod)
PORT=3000

# --- PixelLab (art pipeline; staging/local ONLY — must be ABSENT in prod) ---
# Get from pixellab.ai account page
PIXELLAB_API_KEY=
# Monthly generation cap enforced by the credit ledger
PIXELLAB_MONTHLY_CAP=2000
# Refuse generation when balance below this floor
PIXELLAB_FLOOR=50

# --- Admin art tool (compiled/flagged OUT of prod) ---
ADMIN_ART_ENABLED=false
ADMIN_USER=admin
# openssl rand -hex 32
ADMIN_PASSWORD=

# --- Server ---
# openssl rand -hex 32
SESSION_SECRET=dev-only-not-secret
NODE_ENV=development
# SQLite location; use :memory: for throwaway
DB_PATH=./data/ashfall.db
# Self-ping keep-alive for Render free tier (true in prod if you want 24/7)
KEEP_ALIVE_SELF_PING=false
