{
  "name": "ashfall",
  "version": "0.1.0",
  "private": true,
  "description": "ASHFALL: The Last Bastion — multiplayer post-apocalyptic hidden-role card game",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages tools --ext .ts,.svelte",
    "dev": "pnpm --filter @ashfall/server dev",
    "dev:client": "pnpm --filter @ashfall/client dev",
    "start": "node packages/server/dist/main.js",
    "sim": "node tools/sim/dist/run.js",
    "artgen": "node tools/artgen/dist/cli.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
